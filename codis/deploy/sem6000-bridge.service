[Unit]
Description=SEM6000 ThingsBoard MQTT bridge
Wants=network-online.target bluetooth.service
After=network-online.target bluetooth.service

[Service]
Type=simple
User=sem6000
Group=sem6000
SupplementaryGroups=bluetooth
WorkingDirectory=/opt/sem6000-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sem6000-bridge/.venv/bin/python /opt/sem6000-bridge/codis/usa_sem6000_thingsboard_mqtt.py --config /etc/sem6000-bridge/config.toml
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
